{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "CMake Configure",
        "type": "shell",
        "command": "cmake",
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/Build"
        ],
        "problemMatcher": []
      },
      {
        "label": "CMake Build",
        "type": "shell",
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/Build"
        ],
        "dependsOn": "CMake Configure",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$gcc"
        ]
      }
    ]
  }